# Exemplos locais; não são credenciais de produção.
# API_ADDR é host:port ou :port. Não use URL. Se 8080 estiver ocupada, troque a porta.
API_ADDR=:8080

# Prazos opcionais. Ausente usa o default. Valor inválido ou não positivo impede o boot.
# HTTP_READ_HEADER_TIMEOUT=2s
# HTTP_READ_TIMEOUT=5s
# HTTP_WRITE_TIMEOUT=10s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_SHUTDOWN_TIMEOUT=10s

POSTGRES_DB=gotube
POSTGRES_USER=gotube
POSTGRES_PASSWORD=change-me-local-only

# Usada só pela API e pelos comandos locais. Não é senha de produção.
# A listagem e as rotas de conta falham com 503 se o banco estiver indisponível. /healthz não usa esta URL.
DATABASE_URL=postgres://gotube:change-me-local-only@127.0.0.1:5432/gotube?sslmode=disable

# Segredo só de laboratório para assinar o access token. Não é credencial de produção.
# Ausente: a API sobe e as rotas de conta respondem 503. /healthz não usa este valor.
AUTH_JWT_SECRET=local-lab-secret-not-for-production

# true força o cookie de refresh com Secure. No HTTP local deixe false.
AUTH_COOKIE_SECURE=false

# true devolve o token de reset no corpo, só no laboratório. Produção deixa false.
AUTH_EXPOSE_RESET_TOKEN=false

# GO_API_INTERNAL_URL pertence ao ambiente servidor do Next.js.
# Criar web/.env.example ao implementar o frontend. O arquivo já existe e não é usado no bootstrap.

# Object storage de laboratório. Ausente: as rotas de upload respondem 503. /healthz não usa estes valores.
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_BUCKET=gotube
STORAGE_ACCESS_KEY=gotube
STORAGE_SECRET_KEY=change-me-local-only
STORAGE_REGION=us-east-1
STORAGE_MAX_BYTES=536870912
# Origem do Next que pode fazer PUT direto no bucket. Ausente: o bucket nasce sem CORS.
STORAGE_CORS_ORIGIN=http://127.0.0.1:3016

# Fila do relay e do worker. Ausente: a API sobe e /healthz continua 200.
RABBITMQ_USER=gotube
RABBITMQ_PASSWORD=change-me-local-only
RABBITMQ_URL=amqp://gotube:change-me-local-only@127.0.0.1:5672/

# Binários no host do worker. Ausentes: o worker procura ffmpeg e ffprobe no PATH.
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# PROCESSING_MAX_ATTEMPTS=3
# PROCESSING_LEASE=2m
